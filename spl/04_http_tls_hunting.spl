index=main
| eval src_ip=coalesce('ip.src','ipv6.src'),
       dest_ip=coalesce('ip.dst','ipv6.dst'),
       http_host=lower('http.host'),
       tls_sni=lower('tls.handshake.extensions_server_name')
| where isnotnull(http_host) OR isnotnull(tls_sni)
| stats count AS events
        values(src_ip) AS sources
        values(dest_ip) AS destinations
        BY http_host tls_sni
| sort - events
